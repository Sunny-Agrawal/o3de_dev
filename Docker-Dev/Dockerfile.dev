# Dev Dockerfile for O3DE Engine Development
# Minimal base setup for UID/GID bind mount compatibility

ARG BASE_IMAGE=ubuntu:22.04
FROM ${BASE_IMAGE}

# Avoid interactive tzdata prompt
ENV DEBIAN_FRONTEND=noninteractive

# Create non-root user placeholder
ARG USERNAME=devuser
ARG UID=1000
ARG GID=1000

# Add user and group
RUN groupadd -g $GID $USERNAME \
    && useradd -m -u $UID -g $GID -s /bin/zsh $USERNAME \
    && passwd -d $USERNAME \
    && apt-get update \
    && apt-get install -y \
        sudo \
        git \
        curl \
        ca-certificates \
        locales \
        tzdata \
        bash \
        zsh \
        nano \
        x11-apps \
        clang \
        lld \
        cmake-qt-gui \
        ninja-build \
        libunwind-dev \
        libzstd-dev \
        binutils \
        libglu1-mesa-dev \
        libfontconfig1-dev \
        libxcb-xinerama0 \
        libxcb-xinerama0-dev \
        libxcb-xkb-dev \
        libxcb-randr0 \
        libxcb-randr0-dev \
        libxkbcommon-x11-dev \
        libxkbcommon-dev \
        libxcb-xfixes0-dev \
        libxcb-xinput-dev \
        libxcb-xinput0 \
        libxcb-icccm4-dev \
        libxcb-image0-dev \
        libxcb-keysyms1-dev \
        libxcb-render-util0-dev \
        mesa-common-dev \
        libvulkan1 \
        libx11-dev \
        libpcre2-16-0 \
        libssl-dev \
        libcurl4-openssl-dev \
        pkg-config \
        libxcb-util0-dev \
        xcb-proto \
        libc6-dev \
        zlib1g-dev \
        libstdc++-12-dev \
        tix \
        software-properties-common \
        gnupg \
        xxd \
    && echo "$USERNAME ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers \
    && locale-gen en_US.UTF-8 \
    && wget -O - https://apt.kitware.com/keys/kitware-archive-latest.asc | gpg --dearmor - | tee /etc/apt/trusted.gpg.d/kitware.gpg >/dev/null \
    && add-apt-repository "deb https://apt.kitware.com/ubuntu/ jammy main" \
    && apt-get update \
    && apt-get install -y cmake

# Set environment and working dir
ENV LANG en_US.UTF-8
ENV LC_ALL=en_US.UTF-8
WORKDIR /home/$USERNAME

# Copy entrypoint
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
